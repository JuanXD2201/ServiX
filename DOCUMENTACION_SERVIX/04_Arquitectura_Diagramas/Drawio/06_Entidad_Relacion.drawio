<mxfile host="app.diagrams.net"><diagram id="d1" name="Modelo de datos Firestore"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="ServiX · Entidad-relación / modelo de datos (Cloud Firestore)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#091E42;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="34" as="geometry"/></mxCell><mxCell id="3" value="usuarios/{uid}&lt;br&gt;—&lt;br&gt;uid, email, displayName, phone&lt;br&gt;photoUrl, role (CLIENTE | ADMINISTRADOR)&lt;br&gt;createdAt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#091E42;strokeColor=#091E42;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="330" height="140" as="geometry"/></mxCell><mxCell id="4" value="clientes/{clienteId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0066F5;fontColor=#0B1B36;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="190" height="90" as="geometry"/></mxCell><mxCell id="12" value="subcolección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0066F5;strokeWidth=1.6;fontSize=11;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" value="servicios/{servicioId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0066F5;fontColor=#0B1B36;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="255" y="360" width="190" height="90" as="geometry"/></mxCell><mxCell id="13" value="subcolección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0066F5;strokeWidth=1.6;fontSize=11;" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="notificaciones/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0066F5;fontColor=#0B1B36;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="190" height="90" as="geometry"/></mxCell><mxCell id="14" value="subcolección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0066F5;strokeWidth=1.6;fontSize=11;" edge="1" parent="1" source="3" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" value="actividades/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0066F5;fontColor=#0B1B36;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="685" y="360" width="190" height="90" as="geometry"/></mxCell><mxCell id="15" value="subcolección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0066F5;strokeWidth=1.6;fontSize=11;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="configuracion/&lt;br&gt;app_config · user_profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0066F5;fontColor=#0B1B36;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="190" height="90" as="geometry"/></mxCell><mxCell id="16" value="subcolección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0066F5;strokeWidth=1.6;fontSize=11;" edge="1" parent="1" source="3" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="solicitudes_atencion/{id}  (colección raíz)&lt;br&gt;—&lt;br&gt;id, clienteId (= uid del cliente), clienteNombre, clienteCorreo&lt;br&gt;fechaHora, motivo, mensaje, prioridad, estado&lt;br&gt;respuestaAdmin, atendidoPor, fechaResolucion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#B45309;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="560" height="170" as="geometry"/></mxCell><mxCell id="17" value="clienteId = uid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0066F5;strokeWidth=1.6;fontSize=11;dashed=1;" edge="1" parent="1" source="3" target="9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="Reglas (firestore.rules): cada usuario accede solo a usuarios/{uid}/… (o un administrador); el rol no cambia tras el registro salvo por un administrador; solicitudes_atencion: lectura por el cliente dueño o administrador, creación con clienteId = uid, actualización y borrado solo por administrador; cualquier otra ruta, denegada." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#CBD5E1;fontColor=#0B1B36;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1120" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>